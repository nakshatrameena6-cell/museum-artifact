# Museum Artifact Explorer — Environment Variables Template
# Copy this file to .env and replace the placeholder values with your Supabase credentials.
# NEVER commit your real .env file to version control.

# PostgreSQL connection string from Supabase (Project Settings > Database > Connection string > URI)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Flask Security Key
SECRET_KEY=dev-museum-secret-key-change-in-prod-f9382ab81c0e

# Flask Debug Mode (0 in production, 1 in development)
FLASK_DEBUG=0
